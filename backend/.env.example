# ChronoTrade Backend Environment Configuration

# JWT Secret Key for local development
SECRET_KEY=chronotrade_local_dev_secret_key

# Environment
ENVIRONMENT=development

# Scoped CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Local server port
PORT=8000
