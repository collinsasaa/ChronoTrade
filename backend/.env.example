# ChronoTrade Backend Environment Configuration

# JWT Secret Key (Required in production)
SECRET_KEY=your_production_super_secret_jwt_key_here_change_in_prod

# Environment (production / development)
ENVIRONMENT=production

# Scoped CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://chronotrade.vercel.app

# Server Port (Default: 8000 for dev, 8080 for Docker)
PORT=8000
